# Configuración del despliegue. Copiar a `.env` EN EL SERVIDOR y rellenar.
#
# Este archivo no lleva valores por defecto a propósito: si falta alguno, el
# compose se niega a arrancar en vez de levantar algo mal configurado.

# Subdominio que apunta al servidor.
DOMINIO_API=kuenta.otech-labs.com

# Red Docker donde vive el main_nginx del servidor, para que pueda alcanzar
# este stack por nombre de contenedor. Se averigua con:
#   docker inspect main_nginx --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
RED_PROXY=

# Puerto solo en loopback, para poder probar desde el propio servidor.
PUERTO_INTERNO=8300

# Genérala con:  docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Credenciales de la base de datos. Invéntalas largas: no se escriben a mano
# más que una vez.
DB_DATABASE=gastos
DB_USERNAME=gastos
DB_PASSWORD=
DB_ROOT_PASSWORD=
