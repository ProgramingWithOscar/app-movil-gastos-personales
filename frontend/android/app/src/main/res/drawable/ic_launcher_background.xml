<?xml version="1.0" encoding="utf-8"?>
<!--
  Capa de fondo del icono adaptativo (Android 8+).

  En esas versiones el sistema recorta el icono con la forma que cada lanzador
  quiera —círculo, cuadrado redondeado, gota—, así que el degradado va aquí, a
  sangre, y la marca blanca va en `mipmap/ic_launcher_foreground`. Son los dos
  extremos del degradado del logo original.

  En XML y no en PNG para que salga nítido a cualquier densidad.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#0B685B"
        android:startColor="#13AD80"
        android:type="linear" />
</shape>
