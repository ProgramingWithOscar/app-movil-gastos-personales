# Configuración para compilar el APK de producción.
#
#   cp .env.production.example .env && npm run apk
#
# Al apuntar a HTTPS ya no hace falta `CAP_ALLOW_HTTP`: el permiso de contenido
# mixto se queda apagado, que es como debe ir a una tienda.

API_URL=https://kuenta.otech-labs.com/api
API_URL_NATIVE=https://kuenta.otech-labs.com/api
