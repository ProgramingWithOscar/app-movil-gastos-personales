{
  "name": "gastos-personales-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 8100",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:prod": "ng build --configuration production",
    "sync": "npm run build:prod && cap sync",
    "android": "npm run sync && cap open android",
    "android:run": "npm run sync && cap run android",
    "ios": "npm run sync && cap open ios",
    "config": "node scripts/set-env.mjs",
    "prestart": "node scripts/set-env.mjs",
    "prebuild": "node scripts/set-env.mjs",
    "prebuild:prod": "node scripts/set-env.mjs --prod",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:dev": "CAP_SERVER_URL=http://10.0.2.2:8100 npm run sync && cd android && ./gradlew assembleDebug",
    "apk:lan": "CAP_ALLOW_HTTP=true npm run sync && cd android && ./gradlew assembleDebug",
    "apk:prod": "API_URL=https://kuenta.otech-labs.com/api API_URL_NATIVE=https://kuenta.otech-labs.com/api npm run sync && cd android && ./gradlew assembleDebug",
    "postapk": "node scripts/set-env.mjs",
    "postapk:dev": "node scripts/set-env.mjs",
    "postapk:lan": "node scripts/set-env.mjs",
    "postapk:prod": "node scripts/set-env.mjs",
    "postsync": "node scripts/set-env.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/platform-browser-dynamic": "22.0.1",
    "@angular/router": "22.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "8.5.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "description": "An Ionic project"
}
